# Server Environment Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=https://production-portfolio-sigma.vercel.app

# Authentication
JWT_SECRET=cinematic-super-secret-key-2025
JWT_EXPIRES_IN=7d

# ==========================================
# TiDB Cloud (MySQL 8.0+ Compatible)
# ==========================================
# Option 1: Standard Connection String format:
# mysql://USERNAME:PASSWORD@HOST:4000/portfolio?sslaccept=strict
DATABASE_URL=

# Option 2: Individual Connection Parameters (Supports TIDB_* or DB_*):
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=portfolio

# Alternative environment variable names (also recognized):
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=portfolio

# ==========================================
# Cloudflare B2 (S3-Compatible Object Storage)
# ==========================================
# Supports either B2_KEY_ID or B2_APPLICATION_KEY_ID:
B2_KEY_ID=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
# Optional Cloudflare Worker / Custom CDN Domain for direct high-speed video/image delivery:
B2_PUBLIC_URL=
